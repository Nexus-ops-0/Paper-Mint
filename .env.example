# Optional admin panel. Keep unset unless Supabase and its schema are configured.
# If enabled, use a long random single-segment path, such as /secure-panel-x7k2.
ADMIN_PATH=/secure-panel-x7k2
ADMIN_USERNAME=replace-with-a-unique-username
# Generate with: node scripts/hash-password.mjs
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Optional after your first Vercel deploy. VERCEL_URL is used if omitted.
SITE_URL=
CONTACT_EMAIL=

# Optional persistent content store for admin-edited copy. Create a Supabase free project
# and run the SQL in supabase/schema.sql. Keep the service role key server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
